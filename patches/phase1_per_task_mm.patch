+use x86_64::registers::control::Cr3;
+use x86_64::structures::paging::PhysFrame;
+use crate::kernel::task::Task;

+#[inline(always)]
+#[cfg(feature = "per-task-mm")]
+fn load_task_cr3(t: &Task) {
+    if let Some(root) = t.cr3_root {
+        unsafe { Cr3::write(root, x86_64::registers::control::Cr3Flags::empty()); }
+    }
+}
+
 /// switch_context(current, next) — existing asm saves/restores GPRs/segments.
 pub unsafe fn switch_context(current: *mut super::task::TaskContext,
                              next: *const super::task::TaskContext,
                              cur_task: &Task,
                              next_task: &Task) {
+    #[cfg(feature = "per-task-mm")]
+    {
+        // Load next task's CR3 before returning to it
+        load_task_cr3(next_task);
+    }
     // ... your existing asm push/pop/iretq sequence ...
 }
