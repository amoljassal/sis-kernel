        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 40},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "continuous-GrYlRd"},
            "custom": {
              "orientation": "auto",
              "showThresholdLabels": false,
              "showThresholdMarkers": true
            },
            "max": 10,
            "min": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "green", "value": 7.5}
              ]
            },
            "unit": "short"
          }
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true,
          "text": {}
        }
      },
      {
        "id": 11,
        "title": "Help Desk Tickets by Category",
        "type": "piechart",
        "targets": [
          {
            "expr": "increase(sis_help_desk_tickets_total[24h]) by (ticket_category)",
