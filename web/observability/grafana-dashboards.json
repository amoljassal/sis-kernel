        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 40},
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "pieType": "donut",
          "tooltip": {"mode": "single"}
        }
      },
      {
        "id": 12,
        "title": "Feature Adoption Rate",
        "type": "bargauge",
        "targets": [
          {
            "expr": "avg(sis_feature_adoption_rate) by (feature_name, institution_type)",
            "legendFormat": "{{feature_name}} ({{institution_type}})",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 40},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "continuous-GrYlRd"},
            "custom": {
              "displayMode": "basic",
              "orientation": "horizontal"
            },
            "max": 1,
            "min": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 0.8}
              ]
            },
            "unit": "percentunit"
          }
        },
        "options": {
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "text": {}
        }
      }
    ],
