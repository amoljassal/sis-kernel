+//! Lock-free, per-CPU, single-producer/single-consumer mailbox (u64 messages).
+//! Safe to compile without SMP (becomes a no-op shim).
+use core::sync::atomic::{AtomicUsize, Ordering};
+use core::mem::MaybeUninit;
+use core::cell::UnsafeCell;
+
+#[cfg(feature = "smp")]
+use crate::arch::x86_64::{topology, smp::ipi::{self, IPI_MBOX}};
+
+const CAP: usize = 256;
+
+#[repr(align(64))]
+struct Ring {
+    head: AtomicUsize,
+    tail: AtomicUsize,
+    buf:  UnsafeCell<[u64; CAP]>,
+}
+unsafe impl Sync for Ring {}
+
+impl Ring {
+    const fn new() -> Self {
+        Self{ head: AtomicUsize::new(0), tail: AtomicUsize::new(0), buf: UnsafeCell::new([0; CAP]) }
+    }
+    #[inline] fn push(&self, val: u64) -> bool {
+        let t = self.tail.load(Ordering::Relaxed);
+        let h = self.head.load(Ordering::Acquire);
+        if t.wrapping_add(1) % CAP == h { return false; }
+        unsafe { (*self.buf.get())[t] = val; }
+        self.tail.store((t+1)%CAP, Ordering::Release);
+        true
+    }
+    #[inline] fn pop(&self) -> Option<u64> {
+        let h = self.head.load(Ordering::Relaxed);
+        let t = self.tail.load(Ordering::Acquire);
+        if h == t { return None; }
+        let v = unsafe { (*self.buf.get())[h] };
+        self.head.store((h+1)%CAP, Ordering::Release);
+        Some(v)
+    }
+}
+
+#[cfg(feature = "smp")]
+static mut MBOXES: MaybeUninit<[Ring; 64]> = MaybeUninit::uninit();
+#[cfg(feature = "smp")]
+static INIT: AtomicUsize = AtomicUsize::new(0);
+
+#[cfg(feature = "smp")]
+fn ensure_init() {
+    if INIT.load(Ordering::Acquire) == 1 { return; }
+    if INIT.compare_exchange(0, 2, Ordering::AcqRel, Ordering::Acquire).is_ok() {
+        // init
+        unsafe {
+            let ptr = MBOXES.as_mut_ptr();
+            for i in 0..64 {
+                (*ptr)[i] = Ring::new();
+            }
+        }
+        INIT.store(1, Ordering::Release);
+    } else {
+        while INIT.load(Ordering::Acquire) != 1 { core::hint::spin_loop(); }
+    }
+}
+
+#[cfg(feature = "smp")]
+fn mbox_for_apic(apic: u32) -> Option<&'static Ring> {
+    ensure_init();
+    let idx = topology::cpu_index_from_apic(apic)?;
+    unsafe { Some(&(*MBOXES.as_ptr())[idx]) }
+}
+
+#[cfg(feature = "smp")]
+pub fn send(dst_apic_id: u32, msg: u64) -> bool {
+    if let Some(r) = mbox_for_apic(dst_apic_id) {
+        let ok = r.push(msg);
+        if ok { ipi::send_ipi(dst_apic_id, IPI_MBOX); }
+        return ok;
+    }
+    false
+}
+
+#[cfg(feature = "smp")]
+pub fn try_recv(this_apic_id: u32) -> Option<u64> {
+    if let Some(r) = mbox_for_apic(this_apic_id) { return r.pop(); }
+    None
+}
+
+// ---- No-OP shims when SMP is off (keeps other code compiling) ----
+#[cfg(not(feature = "smp"))]
+#[inline] pub fn send(_dst_apic_id: u32, _msg: u64) -> bool { false }
+#[cfg(not(feature = "smp"))]
+#[inline] pub fn try_recv(_this_apic_id: u32) -> Option<u64> { None }

