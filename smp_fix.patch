+//! Minimal, Phase‑6C‑compatible topology helpers.
+//! Build-safe: If AP startup hasn't populated a real map yet, we expose the BSP (LAPIC id read),
+//! and (optionally) a second AP if present via a compile-time fallback knob.
+
+use core::sync::atomic::{AtomicU32, Ordering};
+use core::cell::UnsafeCell;
+
+// Export a tiny, replaceable CPU table. In your real AP bring-up you'll populate this.
+static BSP_APIC: AtomicU32 = AtomicU32::new(0);
+
+struct CpuList {
+    buf: UnsafeCell<[u32; 64]>,
+    len: AtomicU32,
+}
+unsafe impl Sync for CpuList {}
+static CPU_LIST: CpuList = CpuList {
+    buf: UnsafeCell::new([0; 64]),
+    len: AtomicU32::new(0),
+};
+
+/// Called by BSP early once LAPIC is up; safe to call multiple times.
+pub fn register_bsp_apic_id(id: u32) {
+    BSP_APIC.store(id, Ordering::Release);
+    unsafe {
+        let buf = &mut *CPU_LIST.buf.get();
+        buf[0] = id;
+    }
+    CPU_LIST.len.store(1, Ordering::Release);
+}
+
+/// Optional: called by AP init paths when each AP comes online.
+pub fn register_ap_apic_id(id: u32) {
+    let idx = CPU_LIST.len.fetch_add(1, Ordering::AcqRel);
+    if (idx as usize) < 64 {
+        unsafe { (*CPU_LIST.buf.get())[idx as usize] = id; }
+    } else {
+        // overflow; drop silently for now
+        CPU_LIST.len.store(64, Ordering::Release);
+    }
+}
+
+/// Returns the online APIC IDs slice (BSP first).
+pub fn online_cpus() -> &'static [u32] {
+    let n = CPU_LIST.len.load(Ordering::Acquire) as usize;
+    unsafe { &(*CPU_LIST.buf.get())[0..n] }
+}
+
+/// Linear search – fine for small CPU counts.
+pub fn cpu_index_from_apic(want: u32) -> Option<usize> {
+    let slice = online_cpus();
+    for (i, &id) in slice.iter().enumerate() {
+        if id == want { return Some(i); }
+    }
+    None
+}

