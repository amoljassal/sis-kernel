+
 pub type SysResult = i64; // negative errno on error
 
 // Existing syscalls (0x00..0x03 etc.) kept as-is
 
+// Phase 2: IPC syscall numbers
+#[cfg(feature = "ipc")]
+pub const SYS_IPC_CHAN_CREATE: u64 = 0x20;
+#[cfg(feature = "ipc")]
+pub const SYS_IPC_SEND:        u64 = 0x21;
+#[cfg(feature = "ipc")]
+pub const SYS_IPC_RECV:        u64 = 0x22;
+#[cfg(feature = "ipc")]
+pub const SYS_IPC_CLOSE:       u64 = 0x23;
+
 #[no_mangle]
 pub extern "C" fn syscall_dispatch(
     num: u64, rdi: u64, rsi: u64, rdx: u64, rcx: u64, r8: u64, r9: u64
 ) -> SysResult {
     // Privilege level detection for diagnostics
     let cs = segmentation::cs().0 as u64;
     let rpl = (cs & 0x3) as u8;
 
     match num {
         // … existing cases …
+        #[cfg(feature = "ipc")]
+        n if n == SYS_IPC_CHAN_CREATE => {
+            // rdi=flags, rsi=max_msgs, rdx=msg_size
+            match unsafe { ipc::sys_chan_create(rdi as u32, rsi as usize, rdx as usize) } {
+                Ok(cap) => cap as i64,
+                Err(e) => e,
+            }
+        }
+        #[cfg(feature = "ipc")]
+        n if n == SYS_IPC_SEND => {
+            // rdi=cap_id, rsi=user_ptr, rdx=len
+            match unsafe { ipc::sys_send(rdi as u32, rsi as u64, rdx as usize) } {
+                Ok(n) => n as i64,
+                Err(e) => e,
+            }
+        }
+        #[cfg(feature = "ipc")]
+        n if n == SYS_IPC_RECV => {
+            // rdi=cap_id, rsi=user_ptr, rdx=len, rcx=timeout_us
+            match unsafe { ipc::sys_recv(rdi as u32, rsi as u64, rdx as usize, rcx as u64) } {
+                Ok(n) => n as i64,
+                Err(e) => e,
+            }
+        }
+        #[cfg(feature = "ipc")]
+        n if n == SYS_IPC_CLOSE => {
+            match unsafe { ipc::sys_close(rdi as u32) } {
+                Ok(()) => 0,
+                Err(e) => e,
+            }
+        }
         _ => {
             let _ = rpl; // suppress unused in some feature combos
             serial::write_str("[syscall] unknown\n");
             -38 // -ENOSYS
         }
     }
 }
 
