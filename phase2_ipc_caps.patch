 #!/usr/bin/env bash
 set -euo pipefail
 
 TEST="${TEST:-}"
 
 if [[ -z "${USE_UEFI:-}" || "${USE_UEFI}" == "0" ]]; then
   # BIOS boot via bootimage
   cargo +nightly bootimage --target x86_64-unknown-none
   IMG=target/x86_64-unknown-none/debug/bootimage-sis_kernel.bin
 else
   # UEFI path if you already use a builder; keep as-is else.
   echo "UEFI path not configured in this snippet"; exit 2
 fi
 
+RUSTFLAGS+=" --cfg TEST=\"$TEST\""
 export RUSTFLAGS
 
 # Enable isa-debug-exit for deterministic exits
 exec qemu-system-x86_64 \
   -drive format=raw,file="$IMG" \
   -serial stdio \
   -machine q35 -cpu qemu64 -m 512M -smp 2 \
+  -device isa-debug-exit,iobase=0xf4,iosize=0x04