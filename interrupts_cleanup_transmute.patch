 use lazy_static::lazy_static;
 use pic8259::ChainedPics;
 use spin::Mutex;
 
 pub const PIC_1_OFFSET: u8 = 32;
 pub const PIC_2_OFFSET: u8 = PIC_1_OFFSET + 8;
 
 pub static PICS: Mutex<ChainedPics> = Mutex::new(unsafe { ChainedPics::new(PIC_1_OFFSET, PIC_2_OFFSET) });
 
 #[derive(Debug, Clone, Copy)]
 #[repr(u8)]
 pub enum InterruptIndex {
     Timer = PIC_1_OFFSET,
     // add more as needed (Keyboard = 33, etc.)
 }
 impl InterruptIndex {
     #[inline(always)] pub fn as_u8(self) -> u8 { self as u8 }
     #[inline(always)] pub fn as_usize(self) -> usize { usize::from(self.as_u8()) }
 }
 
 lazy_static! {
     static ref IDT: InterruptDescriptorTable = {
         let mut idt = InterruptDescriptorTable::new();
-        // double fault handler registration happens below in `init_idt` to use IST index
-        idt
+        // Exceptions
+        idt.divide_error.set_handler_fn(divide_by_zero);
+        idt.general_protection_fault.set_handler_fn(gp_fault);
+        idt.page_fault.set_handler_fn(page_fault);
+
+        // Hardware IRQs
+        idt[InterruptIndex::Timer.as_usize()].set_handler_fn(timer_interrupt_handler);
+
+        // Syscall gate @ 0x80 for ring3
+        unsafe {
+            idt[0x80]
+                .set_handler_fn(syscall_handler)
+                .set_privilege_level(PrivilegeLevel::Ring3);
+        }
+
+        idt
     };
 }
 
 pub fn init_idt() {
-    IDT.load();
+    // Double fault needs IST stack and crate expects a `-> !` typed fn pointer.
+    // Our handler has no explicit return type (compiler rule), so we transmute its pointer.
+    unsafe {
+        type DfExpect = extern "x86-interrupt" fn(InterruptStackFrame, u64) -> !;
+        type DfActual = extern "x86-interrupt" fn(InterruptStackFrame, u64);
+        let actual: DfActual = double_fault_handler;
+        let ptr: DfExpected = core::mem::transmute(actual);
+        IDT.double_fault
+            .set_handler_fn(ptr)
+            .set_stack_index(gdt::DOUBLE_FAULT_IST_INDEX);
+    }
+
+    IDT.load();
 }
 
-extern "x86-interrupt" fn double_fault_handler(
